{
  "name": "cafeteria-origen-api-ts",
  "version": "1.0.0",
  "description": "API REST para Cafetería Origen con TypeScript y TDD",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "cafeteria-origen",
    "express",
    "typescript",
    "tdd",
    "vitest",
    "poo"
  ],
  "author": "Grupo 15 - Programación IV",
  "dependencies": {
    "express": "^4.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.7.1",
    "typescript": "^5.4.0",
    "vitest": "^2.1.0"
  }
}